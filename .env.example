# NoteClaire — réglages. Seul APP_PASSWORD compte vraiment ; le reste est facultatif
# (décommentez une ligne pour la changer). Le choix de l'IA se fait dans l'application,
# au premier lancement : rien à écrire ici pour cela.

# Mot de passe d'accès. Obligatoire dès que d'autres appareils du réseau ouvrent NoteClaire.
APP_PASSWORD=

# --- Facultatif -------------------------------------------------------------------------

# Version à installer (latest = la dernière) : NOTECLAIRE_VERSION=1.0.0
# Port de l'application sur cette machine : HTTP_PORT=8080

# Budget IA du mois en euros (0 = sans limite) et prix du modèle pour estimer les coûts.
# AI_MONTHLY_BUDGET_EUR=5
# AI_INPUT_PRICE_EUR_PER_MTOK=0.09
# AI_OUTPUT_PRICE_EUR_PER_MTOK=0.45

# Sauvegardes quotidiennes : nombre gardé (7 par défaut).
# BACKUP_KEEP=7

# --- Pour essayer l'IA sans l'assistant (sinon, laissez vide) ---------------------------
# AI_PROVIDER=openai          # openai, chatgpt, local ou fake (essai sans IA)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_AI_MODEL=qwen3:8b
